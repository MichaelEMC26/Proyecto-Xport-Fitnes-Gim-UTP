# Plantilla de configuracion de la base de datos de Xport Fitness Gym.
# Copiar como "gimnasio-bd.properties" (sin .ejemplo) en UNA de estas rutas:
#   - Servidor Tomcat:  <carpeta de Tomcat>/conf/gimnasio-bd.properties
#   - PC de desarrollo: C:\Users\<usuario>\gimnasio-bd.properties
#   - Cualquier ruta, indicandola en la variable de entorno GYM_DB_CONFIG
# Tambien se pueden usar variables de entorno: GYM_DB_URL, GYM_DB_USER, GYM_DB_PASSWORD.
gym.db.url=jdbc:sqlserver://SERVIDOR;instanceName=INSTANCIA;databaseName=BDGimnasio;encrypt=false;trustServerCertificate=true
gym.db.user=USUARIO
gym.db.password=CONTRASENA

# Pool de conexiones (opcional): máximo de conexiones abiertas a la vez. Por defecto 20.
# Con 0 no se usa pool (una conexión nueva en cada consulta, como antes).
#gym.db.pool.max=20

# Correo para "¿Has olvidado tu clave?" (SMTP). Sin estas claves la opción avisa que no está disponible.
# Puerto 587 con STARTTLS (gym.mail.ssl=false) o 465 con SSL (gym.mail.ssl=true).
gym.mail.host=mail.sisdataperu.com
gym.mail.port=465
gym.mail.ssl=true
gym.mail.user=CUENTA@sisdataperu.com
gym.mail.password=CONTRASENA_DEL_CORREO
gym.mail.from=CUENTA@sisdataperu.com

# Búsqueda de DNI (Reniec) y RUC (Sunat) en el registro de socios (API dniruc.apisperu.com).
# Es el mismo token que usa SisdataGimnasio (frm_ManteClientes2). Sin esta clave la búsqueda avisa que no está configurada.
gym.apisperu.token=TOKEN_DE_APISPERU

# Carpeta del servidor donde se guardan las fotos de los socios (botón "Cargar foto" en Socios).
# La ruta completa de cada foto se graba en Cliente.Foto (máx. 100 caracteres): use una ruta corta.
# Si no se indica: <carpeta de Tomcat>/fotos-socios
#gym.fotos.dir=D:/XportFitnessGym/fotos

# Carpeta del servidor donde se guardan las imágenes de los productos ("Subir Imagen" en Registrar Producto).
# En Productos.Imagen se graba solo el nombre del archivo ({Producto_ID}_{version}.jpg) o una URL https:// externa.
# Si no se indica: <carpeta de Tomcat>/fotos-productos
#gym.productos.dir=D:/XportFitnessGym/productos
